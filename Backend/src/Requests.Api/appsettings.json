{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "FrontendOrigin": "http://localhost:4200"
  },
  "Jwt": {
    "Issuer": "Requests.Api",
    "Audience": "Requests.Client",
    "SigningKey": "dev-only-signing-key-change-in-production-0123456789ABCDEF",
    "ExpiryMinutes": 480
  },
  "Seed": {
    "Admin": {
      "Username": "admin",
      "Password": "admin"
    }
  }
}
