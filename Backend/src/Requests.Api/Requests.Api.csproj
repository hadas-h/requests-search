<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Emit XML docs so Swagger can surface parameter and response descriptions (R17.4). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591: don't require XML comments on every public member; we only document the API surface. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- Structured logging + per-request request logging, pinned for .NET 8 / ASP.NET Core 8 (R17.2). -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <!-- JWT bearer authentication (issued on login, validated per request). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Requests.Application\Requests.Application.csproj" />
    <ProjectReference Include="..\Requests.Infrastructure\Requests.Infrastructure.csproj" />
  </ItemGroup>
</Project>
