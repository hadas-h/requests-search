<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Restrict this solution to the public, free NuGet.org feed only.
    <clear/> drops any package sources inherited from machine/user-level nuget.config
    (including internal/organizational feeds), so the backend never resolves packages
    from anything other than the official public gallery.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
